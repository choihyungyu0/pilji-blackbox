# ── 브이월드 (vworld.kr 마이포털 → 인증키 발급, 서비스 URL = 배포 주소) ──
# 타일 요청은 브라우저가 직접 보내므로 NEXT_PUBLIC_ 로도 노출된다 (브이월드 키는 클라이언트 노출 전제)
VWORLD_KEY=
NEXT_PUBLIC_VWORLD_KEY=
VWORLD_DOMAIN=https://pilji-blackbox.vercel.app

# ── 공공데이터포털 (안양시 도로굴착 15152770, 지하안전정보 15041891 활용신청 후 — P1) ──
DATA_GO_KR_KEY=

# ── LLM (도구 호출) — 없으면 에이전트 대화만 비활성, 문서 생성 버튼은 동작 ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Supabase (판정·작업 로그) — supabase/schema.sql 실행. 없으면 기기(localStorage) 보관으로 폴백 ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 담당자 모드: 기본은 열림(비밀번호 없음, 시연·심사용). 잠그려면 OFFICER_PIN_REQUIRED=1 + ADMIN_PIN(6자리 이상) ──
OFFICER_PIN_REQUIRED=
ADMIN_PIN=
SESSION_SECRET=

# ── 안양 여건 보정·판정 재순위 (기본 켜짐). false 면 보정 전과 똑같이 동작 ──
NEXT_PUBLIC_ADJ_ENABLED=true
